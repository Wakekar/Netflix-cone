pipeline {
  agent any

  environment {
    TMDB_V3_API_KEY = credentials('TMDB_V3_API_KEY')
    IMAGE_NAME = "netflix-clone"
    CONTAINER_NAME = "netflix-app"
  }

  stages {

    stage('Clean Workspace') {
      steps {
        cleanWs()
      }
    }

    stage('Checkout Code') {
      steps {
        git branch: 'Stage',
            url: 'https://github.com/Wakekar/Netflix-cone.git'
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''
          docker build \
            --build-arg TMDB_V3_API_KEY=$TMDB_V3_API_KEY \
            -t $IMAGE_NAME .
        '''
      }
    }

    stage('Deploy Container') {
      steps {
        sh '''
          docker rm -f $CONTAINER_NAME || true
          docker run -d \
            --name $CONTAINER_NAME \
            -p 80:80 \
            $IMAGE_NAME
        '''
      }
    }
  }
}
